# Copy to `.env.local` and fill in the values from your Supabase project
# (Project Settings -> API). Never commit `.env.local`.

# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key. Safe to send to the browser: it identifies the
# project. After sign-in, RLS only returns the signed-in user's rows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never add a service-role key here. `NEXT_PUBLIC_*` variables are inlined into
# the browser bundle, and this application has no need for elevated privileges.


# --- Optional, local tooling only. Not read by the application. ---

# Direct Postgres connection used by `npm run db:migrate:local` and
# `npm run db:verify` to apply and check migrations.
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:5432/spending_tracker
